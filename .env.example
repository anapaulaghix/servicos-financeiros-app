# Opcional: sem .env, o docker compose usa senhas padrão de desenvolvimento local.
# Para usar as suas, copie este arquivo para .env e ajuste os valores. O .env NÃO é versionado.
# Evite os caracteres ; , e " nas senhas (elas são usadas em connection strings).
POSTGRES_USER=app_user
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=servicos_financeiros

# Senha do Redis (contadores do rate limiting).
REDIS_PASSWORD=troque-esta-senha-tambem

# Cria 3 contas de demonstração na primeira subida (true/false).
SEED_DEMO_DATA=true

# Observabilidade (opcional, ~1,5 GB de RAM a mais): descomente as duas linhas para subir
# Elasticsearch + Kibana e enviar os logs da API para lá. Kibana em http://localhost:5601.
# COMPOSE_PROFILES=observability
# ELASTICSEARCH_URL=http://elasticsearch:9200
