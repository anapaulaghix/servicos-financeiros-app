# Copie este arquivo para .env e ajuste os valores. O .env NÃO é versionado.
# Evite os caracteres ; e " na senha (ela é usada em uma connection string).
POSTGRES_USER=app_user
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=servicos_financeiros

# Cria 3 contas de demonstração na primeira subida (true/false).
SEED_DEMO_DATA=true
