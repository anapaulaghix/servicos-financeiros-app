{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": false
  },
  "Swagger": {
    "Enabled": false
  },
  "RateLimiting": {
    "Transactions": {
      "PermitLimit": 20,
      "WindowSeconds": 10
    }
  },
  "Elasticsearch": {
    "Url": ""
  }
}
